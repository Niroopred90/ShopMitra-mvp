{
  "name": "shopmitra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:local": "node scripts/dev-local.mjs",
    "build": "next build",
    "build:feedback": "node scripts/build-feedback.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:ios": "playwright test --config playwright.webkit.config.ts",
    "test:ai": "playwright test --config playwright.ai.config.ts",
    "test:db": "supabase test db",
    "setup:local-env": "node scripts/local-env.mjs",
    "backup:local": "node scripts/local-backup.mjs backup",
    "verify:restore": "node scripts/local-backup.mjs verify",
    "cleanup:sources": "node --env-file=.env.local scripts/cleanup-ai-sources.mjs",
    "test:retention": "node --env-file=.env.local scripts/test-local-retention.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
