# Public pages work without configuration; owner login requires these values.
# Run npm run setup:local-env after starting local Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Permanent HTTPS origin for shared shop links and QR codes. Local testing only:
SITE_URL=http://127.0.0.1:3000

# Server-only: aggregate analytics, rate-limited reporting, and retention cleanup.
SUPABASE_SECRET_KEY=
PUBLIC_RATE_SECRET=
# Set only when a trusted reverse proxy overwrites this header. Empty uses a shared bucket.
TRUSTED_CLIENT_IP_HEADER=

# AI is disabled unless a key and explicit compatible models are configured.
OPENAI_API_KEY=
OPENAI_OFFER_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
