# Public pages work without configuration; owner login requires these values.
# Run npm run setup:local-env after starting local Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Permanent HTTPS origin for shared shop links and QR codes. Local testing only:
SITE_URL=http://127.0.0.1:3000
